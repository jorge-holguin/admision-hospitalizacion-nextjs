# Configuración de Base de Datos SQL Server 2008
# IMPORTANTE: Para SQL Server 2008, se requiere TLS 1.0 y configuración especial de cifrado

# Formato de DATABASE_URL para SQL Server con TLS 1.0:
# sqlserver://HOST:PUERTO;database=NOMBRE_BD;user=USUARIO;password=CONTRASEÑA;encrypt=true;trustServerCertificate=true;poolTimeout=10

# Ejemplo:
DATABASE_URL="sqlserver://172.16.0.10:1433;database=SIGSALUD;user=SA;password=MiPassword123;encrypt=true;trustServerCertificate=true;poolTimeout=10"

# Parámetros importantes:
# - encrypt=true: Habilita cifrado SSL/TLS
# - trustServerCertificate=true: Confía en el certificado del servidor (necesario para SQL Server 2008)
# - poolTimeout=10: Timeout del pool de conexiones (opcional, útil en redes lentas)

# API de Citas (si aplica)
NEXT_PUBLIC_API_CITAS_MASTER_URL="http://192.168.0.252:9011"

# Otras variables de entorno
NODE_ENV=production
PORT=3000
