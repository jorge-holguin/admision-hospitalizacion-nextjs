{
  "paths": {
    "/api/citas": {
      "get": {
        "tags": ["Citas"],
        "summary": "Obtener listado de citas",
        "description": "Retorna un listado paginado de citas médicas",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Número de página",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Tamaño de página",
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "fecha",
            "in": "query",
            "description": "Filtrar por fecha (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "medico",
            "in": "query",
            "description": "Filtrar por código de médico",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "consultorio",
            "in": "query",
            "description": "Filtrar por código de consultorio",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "estado",
            "in": "query",
            "description": "Filtrar por estado (1: Programada, 2: Atendida, 0: Cancelada)",
            "schema": {
              "type": "string",
              "enum": ["0", "1", "2"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de citas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CitaResumen"
                      }
                    },
                    "page": {
                      "type": "integer"
                    },
                    "pageSize": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error del servidor"
          }
        }
      },
      "post": {
        "tags": ["Citas"],
        "summary": "Crear nueva cita",
        "description": "Crea una nueva cita médica",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CitaNueva"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cita creada correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "ID_CITA": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos"
          },
          "500": {
            "description": "Error del servidor"
          }
        }
      }
    },
    "/api/citas/{id}": {
      "get": {
        "tags": ["Citas"],
        "summary": "Obtener detalles de una cita",
        "description": "Retorna los detalles de una cita específica por su ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID de la cita",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalles de la cita",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CitaDetalle"
                }
              }
            }
          },
          "404": {
            "description": "Cita no encontrada"
          },
          "500": {
            "description": "Error del servidor"
          }
        }
      },
      "put": {
        "tags": ["Citas"],
        "summary": "Actualizar cita",
        "description": "Actualiza una cita existente",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID de la cita",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CitaActualizar"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cita actualizada correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos"
          },
          "404": {
            "description": "Cita no encontrada"
          },
          "500": {
            "description": "Error del servidor"
          }
        }
      },
      "delete": {
        "tags": ["Citas"],
        "summary": "Cancelar cita",
        "description": "Cancela una cita (borrado lógico)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID de la cita",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cita cancelada correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Cita no encontrada"
          },
          "500": {
            "description": "Error del servidor"
          }
        }
      }
    },
    "/api/citas/disponibilidad": {
      "get": {
        "tags": ["Citas"],
        "summary": "Verificar disponibilidad de horarios",
        "description": "Verifica la disponibilidad de horarios para un médico y fecha específicos",
        "parameters": [
          {
            "name": "fecha",
            "in": "query",
            "required": true,
            "description": "Fecha a consultar (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "medico",
            "in": "query",
            "required": true,
            "description": "Código del médico",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "consultorio",
            "in": "query",
            "description": "Código del consultorio (opcional)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Disponibilidad de horarios",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "disponibilidad": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "hora": {
                            "type": "string"
                          },
                          "disponible": {
                            "type": "boolean"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Parámetros inválidos"
          },
          "500": {
            "description": "Error del servidor"
          }
        }
      }
    },
    "/api/citas/calendario": {
      "get": {
        "tags": ["Citas"],
        "summary": "Obtener citas para calendario",
        "description": "Obtiene las citas programadas para visualización en calendario",
        "parameters": [
          {
            "name": "inicio",
            "in": "query",
            "required": true,
            "description": "Fecha de inicio (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "fin",
            "in": "query",
            "required": true,
            "description": "Fecha de fin (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "medico",
            "in": "query",
            "description": "Código del médico (opcional)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "consultorio",
            "in": "query",
            "description": "Código del consultorio (opcional)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Eventos para calendario",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "eventos": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/EventoCalendario"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Parámetros inválidos"
          },
          "500": {
            "description": "Error del servidor"
          }
        }
      }
    },
    "/api/citas/reprogramar": {
      "post": {
        "tags": ["Citas"],
        "summary": "Reprogramar cita",
        "description": "Reprograma una cita existente",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CitaReprogramar"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cita reprogramada correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "ID_CITA": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos"
          },
          "404": {
            "description": "Cita no encontrada"
          },
          "500": {
            "description": "Error del servidor"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CitaResumen": {
        "type": "object",
        "properties": {
          "ID_CITA": {
            "type": "string"
          },
          "PACIENTE": {
            "type": "string"
          },
          "NOMBRES": {
            "type": "string"
          },
          "DOCUMENTO": {
            "type": "string"
          },
          "FECHA": {
            "type": "string",
            "format": "date"
          },
          "HORA": {
            "type": "string"
          },
          "MEDICO": {
            "type": "string"
          },
          "NOM_MEDICO": {
            "type": "string"
          },
          "CONSULTORIO": {
            "type": "string"
          },
          "NOM_CONSULTORIO": {
            "type": "string"
          },
          "ESTADO": {
            "type": "string",
            "enum": ["0", "1", "2"]
          },
          "REFERENCIA": {
            "type": "string"
          }
        }
      },
      "CitaDetalle": {
        "type": "object",
        "properties": {
          "ID_CITA": {
            "type": "string"
          },
          "PACIENTE": {
            "type": "string"
          },
          "NOMBRES": {
            "type": "string"
          },
          "DOCUMENTO": {
            "type": "string"
          },
          "FECHA": {
            "type": "string",
            "format": "date"
          },
          "HORA": {
            "type": "string"
          },
          "MEDICO": {
            "type": "string"
          },
          "NOM_MEDICO": {
            "type": "string"
          },
          "CONSULTORIO": {
            "type": "string"
          },
          "NOM_CONSULTORIO": {
            "type": "string"
          },
          "ESTADO": {
            "type": "string",
            "enum": ["0", "1", "2"]
          },
          "REFERENCIA": {
            "type": "string"
          },
          "OBSERVACIONES": {
            "type": "string"
          },
          "SEGURO": {
            "type": "string"
          },
          "NOM_SEGURO": {
            "type": "string"
          }
        }
      },
      "CitaNueva": {
        "type": "object",
        "required": ["PACIENTE", "FECHA", "HORA", "MEDICO", "CONSULTORIO", "SEGURO"],
        "properties": {
          "PACIENTE": {
            "type": "string",
            "description": "ID del paciente"
          },
          "FECHA": {
            "type": "string",
            "format": "date",
            "description": "Fecha de la cita (YYYY-MM-DD)"
          },
          "HORA": {
            "type": "string",
            "description": "Hora de la cita (HH:MM)"
          },
          "MEDICO": {
            "type": "string",
            "description": "Código del médico"
          },
          "CONSULTORIO": {
            "type": "string",
            "description": "Código del consultorio"
          },
          "REFERENCIA": {
            "type": "string",
            "description": "Número de referencia"
          },
          "OBSERVACIONES": {
            "type": "string",
            "description": "Observaciones adicionales"
          },
          "SEGURO": {
            "type": "string",
            "description": "Código del seguro"
          }
        }
      },
      "CitaActualizar": {
        "type": "object",
        "properties": {
          "FECHA": {
            "type": "string",
            "format": "date",
            "description": "Fecha de la cita (YYYY-MM-DD)"
          },
          "HORA": {
            "type": "string",
            "description": "Hora de la cita (HH:MM)"
          },
          "MEDICO": {
            "type": "string",
            "description": "Código del médico"
          },
          "CONSULTORIO": {
            "type": "string",
            "description": "Código del consultorio"
          },
          "OBSERVACIONES": {
            "type": "string",
            "description": "Observaciones adicionales"
          }
        }
      },
      "CitaReprogramar": {
        "type": "object",
        "required": ["ID_CITA", "FECHA", "HORA"],
        "properties": {
          "ID_CITA": {
            "type": "string",
            "description": "ID de la cita a reprogramar"
          },
          "FECHA": {
            "type": "string",
            "format": "date",
            "description": "Nueva fecha de la cita (YYYY-MM-DD)"
          },
          "HORA": {
            "type": "string",
            "description": "Nueva hora de la cita (HH:MM)"
          },
          "MEDICO": {
            "type": "string",
            "description": "Nuevo código del médico (opcional)"
          },
          "CONSULTORIO": {
            "type": "string",
            "description": "Nuevo código del consultorio (opcional)"
          },
          "OBSERVACIONES": {
            "type": "string",
            "description": "Observaciones sobre la reprogramación"
          }
        }
      },
      "EventoCalendario": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "backgroundColor": {
            "type": "string"
          },
          "borderColor": {
            "type": "string"
          },
          "extendedProps": {
            "type": "object",
            "properties": {
              "paciente": {
                "type": "string"
              },
              "nombres": {
                "type": "string"
              },
              "documento": {
                "type": "string"
              },
              "medico": {
                "type": "string"
              },
              "nomMedico": {
                "type": "string"
              },
              "consultorio": {
                "type": "string"
              },
              "nomConsultorio": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
