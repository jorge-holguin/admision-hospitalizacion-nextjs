{
  "paths": {
    "/api/master-tables/medicos": {
      "get": {
        "tags": ["Tablas Maestras"],
        "summary": "Obtener listado de médicos",
        "description": "Retorna un listado paginado de médicos",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Número de página",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Tamaño de página",
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "nombre",
            "in": "query",
            "description": "Filtrar por nombre",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "codigo",
            "in": "query",
            "description": "Filtrar por código",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de médicos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Medico"
                      }
                    },
                    "page": {
                      "type": "integer"
                    },
                    "pageSize": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error del servidor"
          }
        }
      },
      "post": {
        "tags": ["Tablas Maestras"],
        "summary": "Crear nuevo médico",
        "description": "Crea un nuevo registro de médico",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MedicoNuevo"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Médico creado correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "MEDICO": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos"
          },
          "500": {
            "description": "Error del servidor"
          }
        }
      }
    },
    "/api/master-tables/medicos/{id}": {
      "get": {
        "tags": ["Tablas Maestras"],
        "summary": "Obtener detalles de un médico",
        "description": "Retorna los detalles de un médico específico por su ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID del médico",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalles del médico",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Medico"
                }
              }
            }
          },
          "404": {
            "description": "Médico no encontrado"
          },
          "500": {
            "description": "Error del servidor"
          }
        }
      },
      "put": {
        "tags": ["Tablas Maestras"],
        "summary": "Actualizar médico",
        "description": "Actualiza un médico existente",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID del médico",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MedicoActualizar"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Médico actualizado correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos"
          },
          "404": {
            "description": "Médico no encontrado"
          },
          "500": {
            "description": "Error del servidor"
          }
        }
      },
      "delete": {
        "tags": ["Tablas Maestras"],
        "summary": "Eliminar médico",
        "description": "Elimina un médico (borrado lógico)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID del médico",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Médico eliminado correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Médico no encontrado"
          },
          "500": {
            "description": "Error del servidor"
          }
        }
      }
    },
    "/api/medicos/sugerir-codigo": {
      "post": {
        "tags": ["Tablas Maestras"],
        "summary": "Sugerir códigos para médico",
        "description": "Genera códigos disponibles basados en el nombre del médico",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombreCompleto": {
                    "type": "string",
                    "description": "Nombre completo del médico"
                  }
                },
                "required": ["nombreCompleto"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Códigos sugeridos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "codigos": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos"
          },
          "500": {
            "description": "Error del servidor"
          }
        }
      }
    },
